#set( $symbol_dollar = '$' )
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>${symbol_dollar}{env.JAVA_PACKAGES_CODEARTIFACT_REPOSITORY_DOMAIN}-${symbol_dollar}{env.JAVA_PACKAGES_CODEARTIFACT_REPOSITORY_ID}</id>
            <username>${symbol_dollar}{env.AWS_CODEARTIFACT_REPOSITORY_USERNAME}</username>
            <password>${symbol_dollar}{env.CODEARTIFACT_AUTH_TOKEN}</password>
        </server>
    </servers>
    <profiles>
        <profile>
            <id>recruitcrm-java-packages</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <repositories>
                <repository>
                    <id>${symbol_dollar}{env.JAVA_PACKAGES_CODEARTIFACT_REPOSITORY_DOMAIN}-${symbol_dollar}{env.JAVA_PACKAGES_CODEARTIFACT_REPOSITORY_ID}</id>
                    <name>${symbol_dollar}{env.JAVA_PACKAGES_CODEARTIFACT_REPOSITORY_DOMAIN}-${symbol_dollar}{env.JAVA_PACKAGES_CODEARTIFACT_REPOSITORY_ID}</name>
                    <url>${symbol_dollar}{env.JAVA_PACKAGES_CODEARTIFACT_REPOSITORY_URL}</url>
                </repository>
            </repositories>
        </profile>
    </profiles>
</settings>
